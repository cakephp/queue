<?xml version="1.0"?>
<ruleset name="CakePHP PluginInstaller">
    <file>src/</file>
    <file>tests/</file>
    <rule ref="CakePHP" />
    <arg value="nps"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg name="cache" value=".phpcs.cache"/>

    <exclude-pattern>tests/comparisons/*</exclude-pattern>
</ruleset>
